<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/lyrics_list"
        android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false"
        android:paddingVertical="32dp" android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/lyrics_follow"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/lyrics_message" android:layout_width="0dp" android:layout_height="wrap_content"
        android:gravity="center" android:text="@string/no_lyrics" android:textColor="@color/text_secondary" android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/lyrics_retry"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_retry"
        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/retry" android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/lyrics_message" app:layout_constraintBottom_toTopOf="@id/lyrics_follow"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_follow"
        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/lyrics_follow" android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
