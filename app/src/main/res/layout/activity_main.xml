<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <androidx.constraintlayout.utils.widget.ImageFilterView android:id="@+id/back" android:layout_width="48dp" android:layout_height="56dp" android:src="@drawable/ic_player_back" android:scaleType="center" android:contentDescription="@string/back" android:clickable="true" android:focusable="true" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="18dp" android:gravity="center_vertical" android:text="@string/home" android:textSize="23sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" app:layout_constraintStart_toEndOf="@id/back" app:layout_constraintEnd_toStartOf="@id/libraryTab" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/libraryTab" android:layout_width="wrap_content" android:layout_height="56dp" android:paddingHorizontal="16dp" android:gravity="center" android:text="@string/library" android:textColor="@color/text_secondary" android:textSize="18sp" android:clickable="true" android:focusable="true" app:layout_constraintEnd_toStartOf="@id/searchButton" app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.utils.widget.ImageFilterView android:id="@+id/searchButton" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_home_search" android:scaleType="center" android:contentDescription="@string/search" android:clickable="true" android:focusable="true" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/searchBox" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="56dp" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/query" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginStart="18dp" android:hint="@string/search_hint" android:inputType="text" android:maxLines="1" android:singleLine="true" android:imeOptions="actionSearch" android:textSize="16sp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/clearQuery" app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.button.MaterialButton android:id="@+id/clearQuery" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="56dp" android:text="@string/clear" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/actions" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone" android:paddingHorizontal="16dp" app:layout_constraintTop_toBottomOf="@id/searchBox" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/playAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/play_all" app:icon="@drawable/ic_player_play" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.utils.widget.ImageFilterView android:id="@+id/shuffle" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_home_shuffle" android:scaleType="center" android:contentDescription="@string/shuffle" android:clickable="true" android:focusable="true" app:layout_constraintStart_toEndOf="@id/playAll" app:layout_constraintTop_toTopOf="@id/playAll" />
        <androidx.constraintlayout.utils.widget.ImageFilterView android:id="@+id/collectionMore" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_player_more" android:scaleType="center" android:contentDescription="@string/more" android:clickable="true" android:focusable="true" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/playAll" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/refresh" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/actions" app:layout_constraintBottom_toTopOf="@id/footer" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="20dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/footer" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/load_more" android:visibility="gone" app:layout_constraintBottom_toTopOf="@id/miniPlayer" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <include android:id="@+id/miniPlayer" layout="@layout/view_mini_player" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginBottom="10dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
